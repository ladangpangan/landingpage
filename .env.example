# Database — self-hosted MongoDB container (see docker-compose.yaml's `mongo`
# service and DEPLOYMENT.md). Powers the admin-editable WhatsApp number,
# product catalog, orders, and Midtrans credentials. Without these set, the
# public landing page still works fine using built-in defaults, but the admin
# page cannot save changes.
# MONGO_ROOT_PASSWORD must stay identical across every redeploy — generate
# once (e.g. `openssl rand -hex 20`) and keep it in a password manager.
MONGO_ROOT_USER=landing_app
MONGO_ROOT_PASSWORD=
MONGO_DB_NAME=ladang_landing

# Admin login (single shared password, no user accounts).
ADMIN_PASSWORD=
# Random long string used to sign the admin session cookie. Generate with:
# openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Midtrans payment gateway — optional here; can also be set from the admin
# page (Dashboard > Landing Page), which takes precedence once saved there.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ERP integration — optional. When set, every new order is POSTed here right
# after checkout (fire-and-forget, never blocks/breaks checkout on failure)
# so the ERP can create a draft Contact + Sales Order automatically. See
# DEPLOYMENT.md for the expected endpoint contract.
ERP_INTEGRATION_URL=
ERP_INTEGRATION_KEY=
