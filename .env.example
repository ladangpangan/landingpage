# Database (MongoDB Atlas free tier works fine) — powers the admin-editable
# WhatsApp number, product catalog, and Midtrans credentials. Without this set,
# the public landing page still works fine using built-in defaults, but the
# admin page cannot save changes.
MONGO_URL=
MONGO_DB_NAME=ladang_landing

# Admin login (single shared password, no user accounts).
ADMIN_PASSWORD=
# Random long string used to sign the admin session cookie. Generate with:
# openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Midtrans payment gateway — optional here; can also be set from the admin
# page (Dashboard > Landing Page), which takes precedence once saved there.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
